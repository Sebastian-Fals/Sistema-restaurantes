# Copia a apps/api/.env (no se versiona). Todos los valores son ficticios.
# Comentarios en su propia línea: algunos lectores de .env no admiten comentarios al final.

# Clave larga y aleatoria; obligatoria con DEBUG=false.
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=false
# Hosts aceptados por Django; "api" es el nombre del servicio que usa el proxy de Next dentro del compose.
ALLOWED_HOSTS=localhost,127.0.0.1,api
# Origen público del frontend (con esquema), p. ej. https://mesa.tu-dominio.co
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# true cuando el sitio se sirve detrás de HTTPS
COOKIE_SECURE=false

# PostgreSQL EXTERNO (no hay base de datos en el compose).
# Si la BD corre en la misma máquina que Docker, usa host.docker.internal como host.
DATABASE_URL=postgres://usuario:clave@host-externo:5432/mesa

# Correo con Resend (p. ej. RESEND_API_KEY=re_xxxxxxxx). Vacía: los códigos de acceso se imprimen en el log (solo desarrollo).
RESEND_API_KEY=
RESEND_FROM=Mesa <no-reply@tu-dominio.co>
# Con una API key, el adaptador predeterminado es resend. Para el piloto real debe ser resend.
# MAIL_ADAPTER=resend
# Verificar sin enviar mensajes: python manage.py check_mail_configuration
# Limpieza programada de códigos vencidos: python manage.py purge_login_codes
