# Copia a .env (no se versiona). Valores ficticios.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,api
CSRF_TRUSTED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false            # true detrás de HTTPS
# PostgreSQL EXTERNO (no hay base de datos en el compose)
DATABASE_URL=postgres://usuario:clave@host-externo:5432/mesa
# Correo con Resend; sin API key los códigos se imprimen en el log (solo desarrollo)
RESEND_API_KEY=
RESEND_FROM=Mesa <no-reply@tu-dominio.co>
